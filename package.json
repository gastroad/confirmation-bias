{
  "name": "confirmation-bias",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx --env-file-if-exists=.env prisma/seed.ts",
    "grant:admin": "npx tsx --env-file-if-exists=.env scripts/grant-admin.ts",
    "db:verify": "npx tsx --env-file-if-exists=.env scripts/verify-db.ts",
    "db:migrate": "prisma migrate deploy",
    "collect": "npx tsx --env-file-if-exists=.env scripts/collect.ts",
    "cluster:day": "npx tsx --env-file-if-exists=.env scripts/cluster-day.ts",
    "cleanup:dates": "npx tsx --env-file-if-exists=.env scripts/cleanup-dirty-dates.ts",
    "backfill:summary": "npx tsx --env-file-if-exists=.env scripts/backfill-summary.ts",
    "repair:titles": "npx tsx --env-file-if-exists=.env scripts/repair-titles.ts",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.0",
    "next": "16.3.2",
    "openai": "^6.42.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "fast-xml-parser": "^5.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
