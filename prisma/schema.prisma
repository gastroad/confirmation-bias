generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Outlet {
  id      String @id
  name    String
  domain  String
  leaning String // "left" | "center_left" | "center" | "center_right" | "right" | "unknown"

  articles Article[]
}

model Cluster {
  id                  String   @id @default(uuid())
  // KST 기준 하루. 클러스터링은 이 버킷 안에서만 일어난다(날짜 간 격리).
  bucketDate          DateTime @db.Date
  representativeTitle String
  summary             String?
  // 비정규화. 날짜별 목록이 크기순 정렬 + 키셋 페이지네이션을 하므로 매번 세지 않는다.
  articleCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  articles Article[]
  comments Comment[]

  @@index([updatedAt])
  @@index([bucketDate, articleCount(sort: Desc), id(sort: Desc)])
}

model Article {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String   @unique
  publishedAt DateTime
  // publishedAt의 KST 날짜. 일별 배치가 이 컬럼으로 대상을 고른다.
  bucketDate  DateTime @db.Date
  // Float32 raw bytes 512개 = 2,048B. JSON 문자열(≈10KB)에서 옮겨 왔다(storage 5배 절감).
  embedding   Bytes?

  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  clusterId String?
  cluster   Cluster? @relation(fields: [clusterId], references: [id])

  createdAt DateTime @default(now())

  @@index([clusterId])
  @@index([outletId])
  @@index([clusterId, outletId])
  @@index([bucketDate])
  @@index([bucketDate, clusterId])
}

model Comment {
  id String @id @default(uuid())

  clusterId String
  // 클러스터링은 하루 1회 고정 시점에 돌고, 한번 만들어진 날짜는 그대로 굳는다.
  // 다만 관리자 재실행·백필로 같은 날짜를 다시 돌리면 클러스터가 새 id로 재생성되므로,
  // clusterDay가 옛 클러스터 → 새 클러스터로 댓글을 승계한다(server/clustering/daily.ts).
  // Cascade는 승계할 후계자가 없을 때 고아 행이 남지 않게 하는 최후 방어선이다.
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  // neon_auth."user".id. 그 스키마는 Neon Auth가 관리하고 Prisma 밖이라 FK를 걸 수 없다.
  // 탈퇴하면 null이 되고(개인정보 파기) 댓글 본문은 남는다.
  authorId   String?
  // 작성 시점의 표시명. neon_auth와 join할 수 없어 비정규화한다. 이메일은 저장하지 않는다.
  authorName String

  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clusterId, createdAt])
  @@index([authorId])
}
